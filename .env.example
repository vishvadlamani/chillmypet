# Copy to .env for local development. Without these the app falls back to a
# local SQLite file (local.db), which is enough to run everything offline.
#
# Get both values from: turso db show <name> / turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# In production these are Worker secrets, not a file:
#   npx wrangler secret put TURSO_DATABASE_URL
#   npx wrangler secret put TURSO_AUTH_TOKEN
