# Copy to .env for local development. Never commit the real file.

# --- Tenant ---
# Which store to serve when the Host header doesn't match a stores.domain row
# (localhost, preview URLs). Production resolves by Host and ignores this.
DEFAULT_STORE_ID=chillmypet

# --- Database ---
# Without these the app falls back to a local SQLite file (local.db), which is
# enough to run everything offline.
# Get both from: turso db show <name> / turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- Meta Conversions API ---
# SECRET. Events Manager > Settings > Conversions API > Generate access token.
# The pixel id is NOT here: it is public and lives in src/lib/analytics/meta.ts.
META_CAPI_ACCESS_TOKEN=

# Optional. Routes events to Events Manager > Test Events instead of counting
# them as real conversions. Get the code from the Test Events tab.
META_CAPI_TEST_EVENT_CODE=

# Optional overrides.
META_CAPI_API_VERSION=v25.0
# Point at a CAPI Gateway, a proxy, or a local mock. Defaults to graph.facebook.com.
META_CAPI_ENDPOINT=
# Sent as attribution_data.attribution_share when set.
META_ATTRIBUTION_SHARE=

# --- Stripe ---
# SECRET. Without this, payments are off entirely: `commerce.payments` is null
# and checkout falls back to the pre-payment confirmation screen. That is what
# `test:e2e` and `test:store` expect, so leave it unset when running them.
STRIPE_SECRET_KEY=

# SECRET. Signing secret of the endpoint you pointed at POST /api/stripe/webhook.
# Without it no order ever becomes `paid` — the handler rejects every event.
STRIPE_WEBHOOK_SECRET=

# Publishable, not secret: it identifies the account to Stripe.js and is meant to
# reach the browser. Without it there is nothing to mount the inline Payment
# Element with, and checkout uses Stripe's hosted page instead.
STRIPE_PUBLISHABLE_KEY=

# Which methods the store offers, as a `pmc_...` payment method configuration id.
# NOT the `pmd_...` payment method domain — that is the separate wallet
# registration for the site, and belongs in the dashboard, not here. Account
# scoped, so it changes whenever the account does. The browser needs it too: in
# deferred mode the Payment Element draws its list before any intent exists.
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# What the buyer sees on their card statement. Set it whenever the Stripe account
# is not named after the store the customer thinks they bought from — an
# unrecognised descriptor is a leading cause of chargebacks. Max 22 characters.
STRIPE_STATEMENT_DESCRIPTOR=
# Appends to the account's descriptor *prefix*, and only if one is configured.
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX=

# Points the Stripe client at a mock. `npm run test:payments` sets this; it is
# unset in every deployed environment.
STRIPE_API_BASE=

# In production these are Worker secrets, not a file:
#   npx wrangler secret put TURSO_DATABASE_URL
#   npx wrangler secret put TURSO_AUTH_TOKEN
#   npx wrangler secret put META_CAPI_ACCESS_TOKEN
#   npx wrangler secret put STRIPE_SECRET_KEY
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET
#   npx wrangler secret put STRIPE_PUBLISHABLE_KEY
#   npx wrangler secret put STRIPE_PAYMENT_METHOD_CONFIGURATION
