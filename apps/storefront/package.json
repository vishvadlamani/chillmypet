{
	"name": "@chillmypet/storefront",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Backend-for-frontend: SvelteKit storefront plus the server routes that compose commerce modules for this UI.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.js",
		"test:e2e": "node tests/e2e.mjs",
		"deploy": "npm run build && wrangler deploy",
		"test:payments": "node tests/payment-flow.mjs"
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"ecomwithai": "*"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.1.14",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.1.14",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.42.0"
	}
}
