{
	"name": "chillmypet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w @chillmypet/storefront --",
		"build": "npm run build -w @chillmypet/storefront",
		"preview": "npm run preview -w @chillmypet/storefront",
		"check": "npm run check --workspaces --if-present",
		"test": "npm run test --workspaces --if-present && npm run test:hoodie",
		"test:hoodie": "node landing/pouch-pet-hoodie.test.mjs",
		"deploy:hoodie": "sh landing/pouch-pet-hoodie/deploy.sh",
		"test:e2e": "npm run test:e2e -w @chillmypet/storefront",
		"db:migrate": "npm run db:migrate -w @chillmypet/storefront",
		"db:seed": "npm run db:seed -w @chillmypet/storefront",
		"deploy": "npm run deploy -w @chillmypet/storefront",
		"typecheck": "npm run typecheck -w ecomwithai",
		"meta:check": "npm run meta:check -w @chillmypet/storefront",
		"sync:framework": "node scripts/sync-framework.js",
		"test:payments": "npm run test:payments -w @chillmypet/storefront",
		"test:store": "npm run test:store -w @chillmypet/storefront",
		"test:admin": "npm run test:admin -w @chillmypet/storefront",
		"db:content": "npm run db:content -w @chillmypet/storefront",
		"db:products": "npm run db:products -w @chillmypet/storefront"
	}
}
