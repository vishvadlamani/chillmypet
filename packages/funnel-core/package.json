{
	"name": "@funnel/core",
	"version": "0.1.0",
	"description": "Funnel framework — the UI-free core plus its Svelte renderers.",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"files": ["src", "FRAMEWORK.md", "BLOCKS.md"],
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./svelte": {
			"types": "./src/lib/svelte.ts",
			"svelte": "./src/lib/svelte.ts",
			"default": "./src/lib/svelte.ts"
		},
		"./PageLayout.svelte": {
			"types": "./src/lib/PageLayout.svelte",
			"svelte": "./src/lib/PageLayout.svelte",
			"default": "./src/lib/PageLayout.svelte"
		},
		"./WizardLayout.svelte": {
			"types": "./src/lib/WizardLayout.svelte",
			"svelte": "./src/lib/WizardLayout.svelte",
			"default": "./src/lib/WizardLayout.svelte"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
